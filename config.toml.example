# LLM Wiki API 配置（复制为 config.toml 后编辑）
# 密钥请写入环境变量，不要在此文件填写 api_key 明文。

[llm]
# 当前启用的配置档：deepseek | openai | ollama | custom
active = "deepseek"

[llm.profiles.deepseek]
label = "DeepSeek"
base_url = "https://api.deepseek.com/v1"
model = "deepseek-chat"
api_key_env = "DEEPSEEK_API_KEY"

[llm.profiles.openai]
label = "OpenAI ChatGPT"
base_url = "https://api.openai.com/v1"
model = "gpt-4o-mini"
api_key_env = "OPENAI_API_KEY"

[llm.profiles.ollama]
label = "Ollama 本地"
base_url = "http://127.0.0.1:11434/v1"
model = "qwen3:8b"
# 本地 Ollama 通常不需要 key，可留空或沿用 LLM_WIKI_API_KEY
api_key_env = "LLM_WIKI_API_KEY"

# 完全自定义的 OpenAI 兼容端点
[llm.custom]
label = "自定义兼容端点"
base_url = "https://your-gateway.example/v1"
model = "your-model-id"
api_key_env = "LLM_WIKI_API_KEY"

[server]
timeout = 120
max_tokens = 1800
